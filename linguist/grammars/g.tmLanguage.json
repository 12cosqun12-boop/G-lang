{
  "name": "G",
  "scopeName": "source.glang",
  "fileTypes": [
    "g"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.glang",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.glang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.glang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.glang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.glang",
          "match": "\\b(fn|var|if|else|while|break|continue|return)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.glang",
          "match": "\\b(print|printn|putc|argc|argv|alloc|open|create|read|write|close|strlen|streq|lb)\\b"
        }
      ]
    }
  }
}