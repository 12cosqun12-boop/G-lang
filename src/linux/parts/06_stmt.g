fn parse_block(){expect_punct('{');while(1){if(tok_kind[ti]==0){fail("g: syntax error\n");}if(tok_kind[ti]==4&&tok_val[ti]=='}'){break;}parse_stmt();}ti=ti+1;return 0;}
fn stmt_break(){if(loop_depth==0){fail("g: syntax error\n");}emit_z("jmp ");emit_ref("l",loop_end[loop_depth-1]);emit_ch(10);ti=ti+1;expect_punct(';');return 0;}
fn stmt_continue(){if(loop_depth==0){fail("g: syntax error\n");}emit_z("jmp ");emit_ref("l",loop_top[loop_depth-1]);emit_ch(10);ti=ti+1;expect_punct(';');return 0;}
fn stmt_return(){ti=ti+1;if(cur_punct(';')==1){emit_z("xor eax, eax\n");}else{parse_expr(0);}emit_z("jmp ");emit_ref("r",cur_fn);emit_ch(10);expect_punct(';');return 0;}
fn stmt_if(){var f;var e;ti=ti+1;expect_punct('(');parse_expr(0);expect_punct(')');f=next_label();e=next_label();emit_z("test rax, rax\njz ");emit_ref("s",f);emit_ch(10);parse_block();if(cur_is("else",4)==1){emit_z("jmp ");emit_ref("s",e);emit_ch(10);emit_label("s",f);ti=ti+1;if(cur_punct('{')==1){parse_block();}else{parse_stmt();}emit_label("s",e);return 0;}emit_label("s",f);return 0;}
fn stmt_while(){var top;var end;ti=ti+1;top=next_label();end=next_label();emit_label("l",top);expect_punct('(');parse_expr(0);expect_punct(')');emit_z("test rax, rax\njz ");emit_ref("l",end);emit_ch(10);loop_top[loop_depth]=top;loop_end[loop_depth]=end;loop_depth=loop_depth+1;parse_block();loop_depth=loop_depth-1;emit_z("jmp ");emit_ref("l",top);emit_ch(10);emit_label("l",end);return 0;}
fn parse_stmt(){var idx;var i;var depth;var nm;var nl;if(tok_kind[ti]==1){if(cur_is("var",3)==1){skip_to_semi();return 0;}if(cur_is("if",2)==1){return stmt_if();}if(cur_is("while",5)==1){return stmt_while();}if(cur_is("break",5)==1){return stmt_break();}if(cur_is("continue",8)==1){return stmt_continue();}if(cur_is("return",6)==1){return stmt_return();}idx=ti;nm=tok_val[idx];nl=tok_aux[idx];if(tok_kind[idx+1]==4&&tok_val[idx+1]=='='){ti=ti+2;parse_expr(0);if(lookup(nm,nl)==0){fail("g: syntax error\n");}if(v_kind==1){emit_z("mov [rbp-");emit_int(v_off);emit_z("], rax\n");}else if(v_kind==3){emit_z("mov [rel g_");emit_name(v_noff,v_nlen);emit_z("], rax\n");}else{fail("g: syntax error\n");}expect_punct(';');return 0;}if(tok_kind[idx+1]==4&&tok_val[idx+1]=='['){i=idx+1;depth=0;while(1){if(tok_kind[i]==4){if(tok_val[i]=='['){depth=depth+1;}if(tok_val[i]==']'){depth=depth-1;if(depth==0){break;}}}i=i+1;}if(tok_kind[i+1]==4&&tok_val[i+1]=='='){ti=idx+2;parse_expr(0);expect_punct(']');expect_punct('=');emit_z("sub rsp, 16\nmov [rsp], rax\n");parse_expr(0);emit_z("mov rcx, [rsp]\nadd rsp, 16\n");if(lookup(nm,nl)==0){fail("g: syntax error\n");}if(v_kind==2){emit_z("lea rdx, [rbp-");emit_int(v_off);emit_z("]\n");}else if(v_kind==4){emit_z("lea rdx, [rel g_");emit_name(v_noff,v_nlen);emit_z("]\n");}else{fail("g: syntax error\n");}emit_z("mov [rdx + rcx * 8], rax\n");expect_punct(';');return 0;}}}parse_expr(0);expect_punct(';');return 0;}
