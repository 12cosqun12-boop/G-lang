# ===========================================================================
# declarations: globals, locals, functions, whole-program emission
# ===========================================================================
fn collect_globals(){var i;var depth;var noff;var nlen;var count;i=0;while(i<ntok){if(tok_kind[i]!=1){i=i+1;continue;}if(tok_is(i,"fn",2)==1){i=i+1;while(i<ntok){if(tok_kind[i]==4&&tok_val[i]=='{'){break;}i=i+1;}depth=1;i=i+1;while(i<ntok){if(tok_kind[i]==4){if(tok_val[i]=='{'){depth=depth+1;}if(tok_val[i]=='}'){depth=depth-1;if(depth==0){i=i+1;break;}}}i=i+1;}continue;}if(tok_is(i,"var",3)==1){i=i+1;if(tok_kind[i]==1){noff=tok_val[i];nlen=tok_aux[i];count=0;i=i+1;if(tok_kind[i]==4&&tok_val[i]=='['){i=i+1;count=tok_val[i];i=i+2;}add_global(noff,nlen,count);while(i<ntok){if(tok_kind[i]==4&&tok_val[i]==';'){i=i+1;break;}i=i+1;}}continue;}i=i+1;}return 0;}
fn prescan_locals(start){var i;var depth;var count;i=start;depth=0;while(i<ntok){if(tok_kind[i]==4){if(tok_val[i]=='{'){depth=depth+1;i=i+1;continue;}if(tok_val[i]=='}'){depth=depth-1;if(depth==0){return 0;}i=i+1;continue;}}if(tok_kind[i]==1&&i+1<ntok){if(tok_is(i,"var",3)==1&&tok_kind[i+1]==1){count=0;if(i+2<ntok){if(tok_kind[i+2]==4&&tok_val[i+2]=='['){count=tok_val[i+3];}}add_local(tok_val[i+1],tok_aux[i+1],count);}}i=i+1;}return 0;}
fn parse_fn(){var nm;var nl;var idx;var frame;var i;var off;ti=ti+1;idx=expect_ident();nm=tok_val[idx];nl=tok_aux[idx];l_cnt=0;l_bytes=0;param_count=0;expect_punct('(');while(1){if(cur_punct(')')==1){break;}idx=expect_ident();add_local(tok_val[idx],tok_aux[idx],0);param_count=param_count+1;if(param_count>4){fail("g: too many symbols or arguments\n");}if(cur_punct(',')==0){break;}ti=ti+1;}expect_punct(')');prescan_locals(ti);frame=(l_bytes+32+15)&(0-16);fid=fid+1;cur_fn=fid;emit_z("global f_");emit_name(nm,nl);emit_ch(10);emit_z("f_");emit_name(nm,nl);emit_ch(58);emit_ch(10);emit_z("push rbp\nmov rbp, rsp\nsub rsp, ");emit_int(frame);emit_ch(10);i=0;while(i<param_count){off=l_off[i];emit_z("mov [rbp-");emit_int(off);emit_z("], ");if(i==0){emit_z("rcx\n");}if(i==1){emit_z("rdx\n");}if(i==2){emit_z("r8\n");}if(i==3){emit_z("r9\n");}emit_ch(10);i=i+1;}parse_block();emit_z("xor eax, eax\n");emit_label("r",cur_fn);emit_z("mov rsp, rbp\npop rbp\nret\n");return 0;}
fn parse_program(){while(tok_kind[ti]!=0){if(tok_kind[ti]!=1){fail("g: syntax error\n");}if(tok_is(ti,"fn",2)==1){parse_fn();continue;}if(tok_is(ti,"var",3)==1){skip_to_semi();continue;}fail("g: syntax error\n");}return 0;}
fn emit_strings(){var i;var j;emit_z("\nsection .data\n");i=0;while(i<str_count){emit_z("s");emit_int(i);emit_z(": db ");j=0;while(j<str_len[i]){emit_int(lb(&sdata+str_start[i]+j));emit_ch(44);j=j+1;}emit_ch(48);emit_ch(10);i=i+1;}return 0;}
fn emit_globals(){var i;var c;emit_z("\nsection .bss\nalign 8\n");i=0;while(i<g_cnt){emit_z("g_");emit_name(g_nam[i],g_len[i]);emit_z(": resq ");c=g_arr[i];if(c==0){c=1;}emit_int(c);emit_ch(10);i=i+1;}emit_runtime_data();return 0;}
fn is_builtin(off,len){var p;p=&src+off;if(len==2){if(peq(p,"lb",2)==1){return 1;}if(peq(p,"lw",2)==1){return 1;}if(peq(p,"ld",2)==1){return 1;}if(peq(p,"lq",2)==1){return 1;}if(peq(p,"sb",2)==1){return 1;}if(peq(p,"sw",2)==1){return 1;}if(peq(p,"sd",2)==1){return 1;}if(peq(p,"sq",2)==1){return 1;}}if(len==4){if(peq(p,"putc",4)==1){return 1;}if(peq(p,"read",4)==1){return 1;}if(peq(p,"open",4)==1){return 1;}if(peq(p,"exit",4)==1){return 1;}if(peq(p,"argc",4)==1){return 1;}if(peq(p,"argv",4)==1){return 1;}}if(len==5){if(peq(p,"alloc",5)==1){return 1;}if(peq(p,"print",5)==1){return 1;}if(peq(p,"write",5)==1){return 1;}if(peq(p,"close",5)==1){return 1;}if(peq(p,"streq",5)==1){return 1;}}if(len==6){if(peq(p,"printn",6)==1){return 1;}if(peq(p,"create",6)==1){return 1;}if(peq(p,"strlen",6)==1){return 1;}if(peq(p,"memcpy",6)==1){return 1;}}return 0;}
